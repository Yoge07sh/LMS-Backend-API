<div class="container-fluid auth-page">

    <div class="row min-vh-100">

        <!-- Left Panel -->

        <div class="col-lg-6 d-none d-lg-flex left-panel">

            <div class="branding">

                <div class="logo-circle">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>

                <h1 class="mb-3">LMS</h1>

                <h4 class="mb-4">
                    Learn • Build • Grow
                </h4>

                <p class="description">
                    Welcome to the Learning Management System.
                    Manage courses, instructors, students and learning progress
                    from one place.
                </p>

                <div class="mt-5">

                    <h5 class="mb-4">Why Choose Our LMS?</h5>

                    <div class="feature-item mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Manage Courses Efficiently</span>
                    </div>

                    <div class="feature-item mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Track Student Progress</span>
                    </div>

                    <div class="feature-item mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Role Based Authentication</span>
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Secure JWT Authentication</span>
                    </div>

                </div>

            </div>

        </div>

        <!-- Right Panel -->

        <div class="col-lg-6 d-flex justify-content-center align-items-center">

            <div class="login-card">

                <h2 class="mb-2">
                    Welcome Back 👋
                </h2>

                <p class="text-muted mb-4">
                    Sign in to continue
                </p>

                <form action="/auth/login" method="POST">

                    <div class="mb-3">

                        <label class="form-label">
                            Email Address
                        </label>

                        <input type="email" name="email" class="form-control" placeholder="Enter your email" required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Password
                        </label>

                        <div class="password-box">

                            <input type="password" id="password" name="password" class="form-control"
                                placeholder="Enter your password" required>

                            <span id="togglePassword">
                                <i class="fa-solid fa-eye"></i>
                            </span>

                        </div>

                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">

                            <input class="form-check-input" type="checkbox" id="remember">

                            <label class="form-check-label" for="remember">

                                Remember Me

                            </label>

                        </div>

                        <a href="/forgot-password">
                            Forgot Password?
                        </a>

                    </div>

                    <button type="submit" class="btn btn-primary login-btn w-100">

                        Login

                    </button>

                </form>

                <div class="text-center mt-4">

                    Don't have an account?

                    <a href="/register">
                        Register
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

    const togglePassword = document.getElementById("togglePassword");
    const password = document.getElementById("password");

    togglePassword.addEventListener("click", function () {

        if (password.type === "password") {

            password.type = "text";
            this.innerHTML = '<i class="fa-solid fa-eye-slash"></i>';

        } else {

            password.type = "password";
            this.innerHTML = '<i class="fa-solid fa-eye"></i>';

        }

    });

</script>